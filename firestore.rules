rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function roleIs(role){ return signedIn() && profile().role == role; }
  function admin(){ return roleIs('administrator'); }
  function encoder(){ return roleIs('encoder'); }
  function viewer(){ return roleIs('viewer'); }
  match /users/{uid} { allow read: if signedIn(); allow create,update,delete: if admin(); }
  match /churches/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
  match /pastors/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
  match /certificateTemplates/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
  match /dedications/{id} {
    allow read: if signedIn();
    allow create: if (admin() || encoder()) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
    allow update: if (admin() || encoder()) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
    allow delete: if admin();
  }
}}
